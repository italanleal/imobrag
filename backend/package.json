{
  "name": "@imobrag/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.15.0"},
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/integration/api.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "@fastify/swagger": "9.9.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "24.19.2"
  }
}
